digraph MCT {
  graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.22, ranksep=0.55, pad=0.3, bgcolor="white", fontname="Helvetica", labelloc="b", labeljust="l",
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8">
        <TR><TD ALIGN="LEFT" BGCOLOR="#f1f5f9"><B>MCT — RizConnect Madagascar</B> <FONT POINT-SIZE="9">· E = événement, O = opération, barre = synchronisation, R = résultat</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">Les barres noires (S1 à S7) marquent les points de synchronisation entre opérations concurrentes ou différées.</FONT></TD></TR>
      </TABLE>>];
  node [fontname="Helvetica", fontsize=8];
  edge [fontname="Helvetica", fontsize=7, color="#64748b", arrowsize=0.6, penwidth=0.9];

  subgraph cluster_M1 {
    label=<<B>M1</B> — Comptes et utilisateurs>;
    fontsize=10.5; fontcolor="#0f172a"; color="#cbd5e1"; style="rounded"; penwidth=1.1; margin=12;
    M1_0_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E01</B><BR/><FONT POINT-SIZE="7.5">Demande d'inscription par téléphone</FONT>>];
    M1_0_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O01</B><BR/><FONT POINT-SIZE="7.5">Vérifier le numéro, la zone et l’unicité du compte</FONT>>];
    M1_0_O1 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O02</B><BR/><FONT POINT-SIZE="7.5">Envoyer et contrôler le code de vérification SMS</FONT>>];
    M1_0_S [shape=box, style="filled", fillcolor="#0f172a", color="#0f172a", width=0.75, height=0.1, label="", tooltip="S1"];
    M1_0_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R01</B><BR/><FONT POINT-SIZE="7.5">Compte actif + rôle exploitant attribué</FONT>>];
    M1_1_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E02</B><BR/><FONT POINT-SIZE="7.5">Visite de l’agent (exploitant sans smartphone)</FONT>>];
    M1_1_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O03</B><BR/><FONT POINT-SIZE="7.5">Créer le compte au nom de l’exploitant (RF-04)</FONT>>];
    M1_1_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R01</B><BR/><FONT POINT-SIZE="7.5">Compte actif + rôle exploitant attribué</FONT>>];
    M1_2_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E03</B><BR/><FONT POINT-SIZE="7.5">Connexion (téléphone ou e-mail)</FONT>>];
    M1_2_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O04</B><BR/><FONT POINT-SIZE="7.5">Authentifier puis journaliser la session</FONT>>];
    M1_2_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R02</B><BR/><FONT POINT-SIZE="7.5">Session ouverte</FONT>>];
    M1_3_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E04</B><BR/><FONT POINT-SIZE="7.5">Code SMS erroné (3 tentatives)</FONT>>];
    M1_3_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O05</B><BR/><FONT POINT-SIZE="7.5">Suspendre temporairement la demande</FONT>>];
    M1_3_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R03</B><BR/><FONT POINT-SIZE="7.5">Compte non activé</FONT>>];
    M1_0_E -> M1_0_O0;
    M1_0_O0 -> M1_0_O1;
    M1_0_O1 -> M1_0_S;
    M1_0_S -> M1_0_R;
    M1_1_E -> M1_1_O0;
    M1_1_O0 -> M1_1_R;
    M1_2_E -> M1_2_O0;
    M1_2_O0 -> M1_2_R;
    M1_3_E -> M1_3_O0;
    M1_3_O0 -> M1_3_R;
  }

  subgraph cluster_M2 {
    label=<<B>M2</B> — Exploitations, parcelles et matériel déclaré>;
    fontsize=10.5; fontcolor="#0f172a"; color="#cbd5e1"; style="rounded"; penwidth=1.1; margin=12;
    M2_0_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E05</B><BR/><FONT POINT-SIZE="7.5">Création / modification d’une exploitation</FONT>>];
    M2_0_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O06</B><BR/><FONT POINT-SIZE="7.5">Contrôler la zone et l’unicité du code</FONT>>];
    M2_0_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R04</B><BR/><FONT POINT-SIZE="7.5">Exploitation enregistrée</FONT>>];
    M2_1_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E06</B><BR/><FONT POINT-SIZE="7.5">Ajout d’une parcelle (saisie ou tracé GPS)</FONT>>];
    M2_1_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O07</B><BR/><FONT POINT-SIZE="7.5">Calculer la superficie et enregistrer la géométrie</FONT>>];
    M2_1_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R05</B><BR/><FONT POINT-SIZE="7.5">Parcelle rattachée à l’exploitation</FONT>>];
    M2_2_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E07</B><BR/><FONT POINT-SIZE="7.5">Déclaration du matériel possédé</FONT>>];
    M2_2_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O08</B><BR/><FONT POINT-SIZE="7.5">Mettre à jour le référentiel de possession</FONT>>];
    M2_2_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R06</B><BR/><FONT POINT-SIZE="7.5">Possession à jour</FONT>>];
    M2_0_E -> M2_0_O0;
    M2_0_O0 -> M2_0_R;
    M2_1_E -> M2_1_O0;
    M2_1_O0 -> M2_1_R;
    M2_2_E -> M2_2_O0;
    M2_2_O0 -> M2_2_R;
  }

  subgraph cluster_M3 {
    label=<<B>M3</B> — Calendrier cultural>;
    fontsize=10.5; fontcolor="#0f172a"; color="#cbd5e1"; style="rounded"; penwidth=1.1; margin=12;
    M3_0_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E08</B><BR/><FONT POINT-SIZE="7.5">Création d’un cycle cultural</FONT>>];
    M3_0_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O09</B><BR/><FONT POINT-SIZE="7.5">Sélectionner le modèle régional (variété + type de riziculture)</FONT>>];
    M3_0_O1 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O10</B><BR/><FONT POINT-SIZE="7.5">Générer les étapes datées (RG-02, RG-03)</FONT>>];
    M3_0_S [shape=box, style="filled", fillcolor="#0f172a", color="#0f172a", width=0.75, height=0.1, label="", tooltip="S2"];
    M3_0_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R07</B><BR/><FONT POINT-SIZE="7.5">Calendrier de la parcelle</FONT>>];
    M3_1_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E09</B><BR/><FONT POINT-SIZE="7.5">Retard des pluies, sécheresse ou alerte reçue</FONT>>];
    M3_1_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O11</B><BR/><FONT POINT-SIZE="7.5">Calculer les dates décalées et créer la proposition</FONT>>];
    M3_1_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R08</B><BR/><FONT POINT-SIZE="7.5">Décalage proposé (non appliqué)</FONT>>];
    M3_2_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E10</B><BR/><FONT POINT-SIZE="7.5">Validation par l’exploitant ou son agent</FONT>>];
    M3_2_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O12</B><BR/><FONT POINT-SIZE="7.5">Appliquer le décalage et replanifier les rappels</FONT>>];
    M3_2_S [shape=box, style="filled", fillcolor="#0f172a", color="#0f172a", width=0.75, height=0.1, label="", tooltip="S2"];
    M3_2_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R09</B><BR/><FONT POINT-SIZE="7.5">Étapes replanifiées</FONT>>];
    M3_3_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E11</B><BR/><FONT POINT-SIZE="7.5">Date prévue atteinte (tâche planifiée)</FONT>>];
    M3_3_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O13</B><BR/><FONT POINT-SIZE="7.5">Émettre le rappel par notification ou SMS</FONT>>];
    M3_3_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R10</B><BR/><FONT POINT-SIZE="7.5">Rappel envoyé</FONT>>];
    M3_0_E -> M3_0_O0;
    M3_0_O0 -> M3_0_O1;
    M3_0_O1 -> M3_0_S;
    M3_0_S -> M3_0_R;
    M3_1_E -> M3_1_O0;
    M3_1_O0 -> M3_1_R;
    M3_2_E -> M3_2_O0;
    M3_2_O0 -> M3_2_S;
    M3_2_S -> M3_2_R;
    M3_3_E -> M3_3_O0;
    M3_3_O0 -> M3_3_R;
  }

  subgraph cluster_M4 {
    label=<<B>M4</B> — Bibliothèque technique et formation>;
    fontsize=10.5; fontcolor="#0f172a"; color="#cbd5e1"; style="rounded"; penwidth=1.1; margin=12;
    M4_0_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E12</B><BR/><FONT POINT-SIZE="7.5">Publication d’une fiche ou d’une formation</FONT>>];
    M4_0_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O14</B><BR/><FONT POINT-SIZE="7.5">Contrôler le contenu bilingue puis publier</FONT>>];
    M4_0_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R11</B><BR/><FONT POINT-SIZE="7.5">Contenu publié</FONT>>];
    M4_1_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E13</B><BR/><FONT POINT-SIZE="7.5">Fin d’un module de quiz</FONT>>];
    M4_1_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O15</B><BR/><FONT POINT-SIZE="7.5">Corriger et calculer le score</FONT>>];
    M4_1_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R12</B><BR/><FONT POINT-SIZE="7.5">Progression enregistrée</FONT>>];
    M4_2_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E14</B><BR/><FONT POINT-SIZE="7.5">Demande de conseil pour une étape en cours</FONT>>];
    M4_2_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O16</B><BR/><FONT POINT-SIZE="7.5">Croiser matériel déclaré × étape × zone</FONT>>];
    M4_2_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R13</B><BR/><FONT POINT-SIZE="7.5">Recommandation personnalisée</FONT>>];
    M4_0_E -> M4_0_O0;
    M4_0_O0 -> M4_0_R;
    M4_1_E -> M4_1_O0;
    M4_1_O0 -> M4_1_R;
    M4_2_E -> M4_2_O0;
    M4_2_O0 -> M4_2_R;
  }

  subgraph cluster_M5 {
    label=<<B>M5</B> — Alertes climatiques>;
    fontsize=10.5; fontcolor="#0f172a"; color="#cbd5e1"; style="rounded"; penwidth=1.1; margin=12;
    M5_0_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E15</B><BR/><FONT POINT-SIZE="7.5">Saisie d’une alerte par le BNGRC ou la météo</FONT>>];
    M5_0_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O17</B><BR/><FONT POINT-SIZE="7.5">Vérifier le ciblage géographique et la priorité (RG-04)</FONT>>];
    M5_0_O1 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O18</B><BR/><FONT POINT-SIZE="7.5">Diffuser par push, SMS et USSD</FONT>>];
    M5_0_S [shape=box, style="filled", fillcolor="#0f172a", color="#0f172a", width=0.75, height=0.1, label="", tooltip="S3"];
    M5_0_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R14</B><BR/><FONT POINT-SIZE="7.5">Alertes envoyées aux exploitations ciblées</FONT>>];
    M5_1_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E16</B><BR/><FONT POINT-SIZE="7.5">Accusé de réception de l’exploitant</FONT>>];
    M5_1_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O19</B><BR/><FONT POINT-SIZE="7.5">Mettre à jour le statut de diffusion</FONT>>];
    M5_1_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R15</B><BR/><FONT POINT-SIZE="7.5">Accusé enregistré</FONT>>];
    M5_2_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E17</B><BR/><FONT POINT-SIZE="7.5">Alerte prioritaire reçue (cyclone)</FONT>>];
    M5_2_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O20</B><BR/><FONT POINT-SIZE="7.5">Proposer un décalage du calendrier (vers O11)</FONT>>];
    M5_2_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R16</B><BR/><FONT POINT-SIZE="7.5">Décalage proposé</FONT>>];
    M5_3_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E18</B><BR/><FONT POINT-SIZE="7.5">Relevé pluviométrique du jour</FONT>>];
    M5_3_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O21</B><BR/><FONT POINT-SIZE="7.5">Calculer le déficit à 10 et 20 jours</FONT>>];
    M5_3_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R17</B><BR/><FONT POINT-SIZE="7.5">Indicateur de sécheresse</FONT>>];
    M5_0_E -> M5_0_O0;
    M5_0_O0 -> M5_0_O1;
    M5_0_O1 -> M5_0_S;
    M5_0_S -> M5_0_R;
    M5_1_E -> M5_1_O0;
    M5_1_O0 -> M5_1_R;
    M5_2_E -> M5_2_O0;
    M5_2_O0 -> M5_2_R;
    M5_3_E -> M5_3_O0;
    M5_3_O0 -> M5_3_R;
  }

  subgraph cluster_M6 {
    label=<<B>M6</B> — Matériel agricole>;
    fontsize=10.5; fontcolor="#0f172a"; color="#cbd5e1"; style="rounded"; penwidth=1.1; margin=12;
    M6_0_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E19</B><BR/><FONT POINT-SIZE="7.5">Demande de réservation d’un équipement</FONT>>];
    M6_0_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O22</B><BR/><FONT POINT-SIZE="7.5">Vérifier la disponibilité sur la période demandée</FONT>>];
    M6_0_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R18</B><BR/><FONT POINT-SIZE="7.5">Réservation demandée</FONT>>];
    M6_1_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E20</B><BR/><FONT POINT-SIZE="7.5">Réponse du propriétaire</FONT>>];
    M6_1_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O23</B><BR/><FONT POINT-SIZE="7.5">Confirmer ou refuser, puis notifier le demandeur</FONT>>];
    M6_1_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R19</B><BR/><FONT POINT-SIZE="7.5">Réservation confirmée ou refusée</FONT>>];
    M6_2_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E21</B><BR/><FONT POINT-SIZE="7.5">Fin de la location</FONT>>];
    M6_2_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O24</B><BR/><FONT POINT-SIZE="7.5">Clôturer et mettre à jour l’état du matériel</FONT>>];
    M6_2_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R20</B><BR/><FONT POINT-SIZE="7.5">Équipement remis en service</FONT>>];
    M6_0_E -> M6_0_O0;
    M6_0_O0 -> M6_0_R;
    M6_1_E -> M6_1_O0;
    M6_1_O0 -> M6_1_R;
    M6_2_E -> M6_2_O0;
    M6_2_O0 -> M6_2_R;
  }

  subgraph cluster_M7 {
    label=<<B>M7</B> — GCV, stocks et financement>;
    fontsize=10.5; fontcolor="#0f172a"; color="#cbd5e1"; style="rounded"; penwidth=1.1; margin=12;
    M7_0_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E22</B><BR/><FONT POINT-SIZE="7.5">Dépôt de paddy au GCV</FONT>>];
    M7_0_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O25</B><BR/><FONT POINT-SIZE="7.5">Contrôler l’adhésion, peser et qualifier</FONT>>];
    M7_0_O1 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O26</B><BR/><FONT POINT-SIZE="7.5">Enregistrer le mouvement et émettre le reçu</FONT>>];
    M7_0_S [shape=box, style="filled", fillcolor="#0f172a", color="#0f172a", width=0.75, height=0.1, label="", tooltip="S4"];
    M7_0_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R21</B><BR/><FONT POINT-SIZE="7.5">Stock augmenté + reçu numérique</FONT>>];
    M7_1_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E23</B><BR/><FONT POINT-SIZE="7.5">Demande de retrait</FONT>>];
    M7_1_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O27</B><BR/><FONT POINT-SIZE="7.5">Vérifier la décision collective (RG-06) et le stock disponible</FONT>>];
    M7_1_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R22</B><BR/><FONT POINT-SIZE="7.5">Retrait autorisé ou refusé</FONT>>];
    M7_2_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E24</B><BR/><FONT POINT-SIZE="7.5">Demande de crédit de campagne</FONT>>];
    M7_2_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O28</B><BR/><FONT POINT-SIZE="7.5">Constituer le dossier et la garantie en stock</FONT>>];
    M7_2_O1 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O29</B><BR/><FONT POINT-SIZE="7.5">Instruction et décision de l’IMF</FONT>>];
    M7_2_S [shape=box, style="filled", fillcolor="#0f172a", color="#0f172a", width=0.75, height=0.1, label="", tooltip="S5"];
    M7_2_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R23</B><BR/><FONT POINT-SIZE="7.5">Statut de la demande mis à jour</FONT>>];
    M7_3_E [shape=ellipse, style="filled", fillcolor="#fef9c3", color="#a16207", label=<<B>E25</B><BR/><FONT POINT-SIZE="7.5">Relevé des prix du marché</FONT>>];
    M7_3_O0 [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1d4ed8", label=<<B>O30</B><BR/><FONT POINT-SIZE="7.5">Publier les prix et alerter si prix favorable</FONT>>];
    M7_3_R [shape=box, style="rounded,filled", fillcolor="#dcfce7", color="#15803d", label=<<B>R24</B><BR/><FONT POINT-SIZE="7.5">Prix publiés</FONT>>];
    M7_0_E -> M7_0_O0;
    M7_0_O0 -> M7_0_O1;
    M7_0_O1 -> M7_0_S;
    M7_0_S -> M7_0_R;
    M7_1_E -> M7_1_O0;
    M7_1_O0 -> M7_1_R;
    M7_2_E -> M7_2_O0;
    M7_2_O0 -> M7_2_O1;
    M7_2_O1 -> M7_2_S;
    M7_2_S -> M7_2_R;
    M7_3_E -> M7_3_O0;
    M7_3_O0 -> M7_3_R;
  }

  subgraph cluster_M8 {
    label=<<B>M8</B> — Suivi de production et tableaux de bord>;
