digraph MLD {
  graph [rankdir=TB, splines=true, overlap=false, nodesep=0.3, ranksep=1.0, pad=0.35, bgcolor="white", fontname="Helvetica", labelloc="b", labeljust="l",
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#f1f5f9"><B>MLD — RizConnect Madagascar</B> <FONT POINT-SIZE="9">· PostgreSQL 16 / PostGIS · PK = clé primaire, FK = clé étrangère, UK = clé candidate</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">Relation 1,N</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">patte de corbeau côté table porteuse de la clé étrangère</FONT></TD></TR>
      </TABLE>>];
  node [fontname="Helvetica", fontsize=9, margin=0];
  edge [fontname="Helvetica", fontsize=7.5, color="#94a3b8"];

  subgraph cluster_D1 {
    label=<<B>D1</B> — Comptes, référentiel et administration<BR/><FONT POINT-SIZE="8">Modules M1 · M10</FONT>>;
    fontsize=11; fontcolor="#2563eb"; color="#2563eb"; style="rounded,dashed"; penwidth=1.2; margin=14;
  ZONE [shape=plaintext, tooltip="Découpage région → district → commune → Fokontany (RF-03). Relation réflexive pour la hiérarchie.", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>zone</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Zone administrative</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">code <FONT COLOR="#047857"><B>UK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">nom</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">type_zone</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">population</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">actif</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>parent_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  ORGANISATION [shape=plaintext, tooltip="Coopérative, IMF, ONG, CFAMA, MAEP, BNGRC ou service météo (RF-02, RF-26, RF-33).", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>organisation</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Organisation partenaire</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">nom</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">type_organisation</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">telephone</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">email</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">actif</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>zone_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  UTILISATEUR [shape=plaintext, tooltip="Compte identifié par son téléphone (RF-01), rattaché à une zone et éventuellement à une organisation.", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>utilisateur</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Utilisateur</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">telephone <FONT COLOR="#047857"><B>UK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">email <FONT COLOR="#047857"><B>UK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">nom</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">prenom</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">mot_de_passe_hash</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">text</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">langue</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">statut</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">consentement_le</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">date_inscription</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>zone_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>organisation_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  ROLE [shape=plaintext, tooltip="Référentiel des rôles : exploitant, agent, coopérative, IMF, MAEP, BNGRC, administrateur (RF-02).", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>role</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Rôle</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>code</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">libelle</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">description</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">text</FONT></TD></TR>
    </TABLE>>];
  UTILISATEUR_ROLE [shape=plaintext, tooltip="Association-entité : un utilisateur peut cumuler des rôles, avec un périmètre géographique (RG-07).", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>utilisateur_role</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Affectation de rôle</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">date_attribution</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">actif</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>utilisateur_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>role_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(24)</FONT></TD></TR>
    </TABLE>>];
  APPAREIL [shape=plaintext, tooltip="Terminal Android ou navigateur utilisé pour la synchronisation hors ligne (RF-46).", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>appareil</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Appareil</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">identifiant_appareil <FONT COLOR="#047857"><B>UK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">plateforme</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">version_app</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">derniere_sync</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>utilisateur_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  PARAMETRE [shape=plaintext, tooltip="Paramétrage des régions, saisons, variétés et seuils (RF-50), modifiable par un administrateur.", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>parametre</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Paramètre</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>cle</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">valeur</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">text</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">type_valeur</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">libelle</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">modifie_le</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>modifie_par_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  SEUIL_ALERTE [shape=plaintext, tooltip="Seuils pluviométriques par zone utilisés pour qualifier la sécheresse (RF-25, RF-50).", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>seuil_alerte</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Seuil d'alerte</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">type_alerte</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">cumul_10j_mm</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">numeric(6,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">cumul_20j_mm</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">numeric(6,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">niveau</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">actif</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>zone_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  JOURNAL_AUDIT [shape=plaintext, tooltip="Traçabilité des actions, des synchronisations et des accès (RF-49).", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>journal_audit</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Journal d'audit</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">bigserial</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">action</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">entite</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(48)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">entite_id</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">details</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">adresse_ip</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">inet</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">date_action</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>utilisateur_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  SYNCHRONISATION [shape=plaintext, tooltip="Journal des remontées hors ligne (RF-46) : volume, durée, conflits éventuels.", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#2563eb" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dbeafe" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>synchronisation</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Synchronisation</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">debut_le</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">fin_le</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">nb_enregistrements</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">statut</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>appareil_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
    </TABLE>>];
  }

  subgraph cluster_D2 {
    label=<<B>D2</B> — Exploitations, parcelles et calendrier cultural<BR/><FONT POINT-SIZE="8">Modules M2 · M3 · M8</FONT>>;
    fontsize=11; fontcolor="#16a34a"; color="#16a34a"; style="rounded,dashed"; penwidth=1.2; margin=14;
  EXPLOITATION [shape=plaintext, tooltip="Unité de production d'un exploitant dans un Fokontany (RF-05).", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#16a34a" BGCOLOR="#ffffff">
      <TR><TD COLSPAN="2" BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="9.5"><B>exploitation</B></FONT> <FONT POINT-SIZE="7.5" COLOR="#334155">Exploitation</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><U><B>id</B></U> <FONT COLOR="#b91c1c"><B>PK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">code <FONT COLOR="#047857"><B>UK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">nom</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">telephone</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">superficie_totale_ha</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">numeric(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">statut</FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>proprietaire_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8"><I>zone_id</I> <FONT COLOR="#1d4ed8"><B>FK</B></FONT></FONT></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="7.5" COLOR="#475569">uuid</FONT></TD></TR>
